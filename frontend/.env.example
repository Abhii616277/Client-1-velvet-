# Public browser configuration only.
# NEVER place backend secrets (DATABASE_URL, JWT_SECRET, passwords) in VITE_ variables.
# VITE_ variables are bundled and exposed publicly to browser clients.

# Local development:
VITE_API_URL=http://localhost:8000/api/v1

# Production example on Netlify:
# VITE_API_URL=https://YOUR-BACKEND-DOMAIN.example/api/v1
# (Note: VITE_API_BASE_URL is also supported as an alias)
