# Local development: sqlite:///./velvet_touch_spa.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set true for a local SQLite database. In production, run Alembic migrations
# before startup and set this to false.
AUTO_CREATE_TABLES=true

# Comma-separated allowed browser origins. Use the deployed Netlify/custom
# frontend URL in production.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:8000
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional integrations. Do not put production credentials in this file.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
